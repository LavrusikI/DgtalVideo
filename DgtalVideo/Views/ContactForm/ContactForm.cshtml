@using DgtalVideo.Localizations.ContactForm
@model DgtalVideo.Models.ContactFormViewModel
<section>
    <section class="content-block">
        <div class="container">
            <form method="post"
                  asp-controller="ContactForm"
                  asp-action="SubmitContactForm"
                  class="admin-form">
                <label>@ContactForm.Contact_form_header</label>
               <div>
                    @Html.TextBox("NameCustomer", null, new { placeholder = @ContactForm.Contact_form_how_should_i_address_you })
                    @Html.ValidationMessageFor(x => x.NameCustomer)
               </div> 
                <div>
                    @Html.TextBox("MobilePhone", null, new { placeholder = "+7(9XX)XXX-XX-XX" })
                    @Html.ValidationMessageFor(x => x.MobilePhone)
                </div>
                <div>
                    @Html.TextBox("ApplicationText", null, new { placeholder = @ContactForm.Contact_form_please_briedly })
                    @Html.ValidationMessageFor(x => x.ApplicationText)
                </div>
                <button type="submit"
                        class="admin-button admin-button--secondary admin-button--block">
                    @ContactForm.Contact_form_send
                </button>
            </form>
        </div>
    </section>
</section>